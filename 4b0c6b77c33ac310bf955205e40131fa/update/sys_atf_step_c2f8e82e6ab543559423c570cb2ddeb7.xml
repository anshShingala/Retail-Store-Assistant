        <value>(function(outputs, steps, params, stepResult, assertEqual) {
  var gr = new GlideRecord('x_1945330_retail_0_inv_txn');
  gr.addQuery('idempotency_key', 'UAT-SEC-004-TXN-001');
  gr.query();
  if (gr.next()) {
    gr.deleteRecord();
  }
  var check = new GlideRecord('x_1945330_retail_0_inv_txn');
  check.addQuery('idempotency_key', 'UAT-SEC-004-TXN-001');
  check.query();
  assertEqual({
    name: 'Transaction record should still exist after delete attempt',
    shouldbe: true,
    value: check.hasNext()
  });
  stepResult.setOutputMessage('Confirmed: Transaction deletion was prevented by business rule');
})(outputs, steps, params, stepResult, assertEqual);</value>
