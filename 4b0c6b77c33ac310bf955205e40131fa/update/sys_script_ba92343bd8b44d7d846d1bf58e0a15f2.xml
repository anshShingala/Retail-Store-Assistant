    <script><![CDATA[(function setReservationDefaults() {
    // Set default status to 'requested' and record requested_on timestamp
    if (!current.getValue('status')) {
        current.setValue('status', 'requested');
    }

    var now = new GlideDateTime();
    current.setValue('requested_on', now.getDisplayValue());
})();
]]></script>
